#!/bin/sh
# Article 121 is a public repository. Before every commit:
#  1. gitleaks scans the staged changes for secrets (keys, tokens, passwords) and blocks the commit if any are found;
#  2. local-only files (MEX project memory) are refused.
# Enable once per clone: git config core.hooksPath tools/git-hooks   (needs gitleaks: brew install gitleaks)
set -e
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); refusing to commit unscanned changes." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --log-level warn . || {
  echo "pre-commit: possible secret in the staged changes. Remove it (and rotate it if it was real) before committing." >&2
  exit 1
}
blocked=$(git diff --cached --name-only | grep -E '^(\.mex/|CLAUDE\.md$|\.claude/skills/mex-)' || true)
if [ -n "$blocked" ]; then
  echo "pre-commit: MEX memory files are local only and must not be committed:" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  echo "Unstage them with: git restore --staged .mex CLAUDE.md .claude/skills" >&2
  exit 1
fi
