---
// The case file: a black folder with red cover-sheet borders that opens under a desk lamp.
// The scene starts only when the desk scrolls into view.
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
const photo = (await getEntry('photos', 'a12-flying'))!;
const tex = await getImage({ src: photo.data.file, width: 1400, format: 'jpg' });
---
<div class="desk" data-photo={tex.src} aria-label="A black case folder opening under a desk lamp">
  <canvas aria-hidden="true"></canvas>
  <span class="label hint">Move the pointer to aim the lamp</span>
</div>
<style>
  .desk { position: relative; min-height: 520px; height: 100%; background: radial-gradient(ellipse at 40% 35%, #151b24 0%, #07090c 70%); border: 1px solid var(--seam); }
  .desk canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .desk .hint { position: absolute; left: 14px; bottom: 12px; }
  .desk.nogl .hint { display: none; }
  @media (max-width: 900px) { .desk { min-height: 380px; } }
</style>
<script>
  import * as THREE_NS from 'three';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const host of document.querySelectorAll<HTMLElement>('.desk')) {
    const canvas = host.querySelector('canvas')!;
    const start = new IntersectionObserver(async ([en]) => {
      if (!en.isIntersecting) return;
      start.disconnect();
      try {
        const THREE = THREE_NS;
        await scene(THREE, host, canvas);
      } catch (err) {
        host.dataset.error = String(err).slice(0, 200);
        host.classList.add('nogl');
      }
    }, { rootMargin: '200px' });
    start.observe(host);
  }

  async function scene(THREE: typeof import('three'), host: HTMLElement, canvas: HTMLCanvasElement) {

    let renderer: any;
    try { renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true }); } catch (e) { host.classList.add('nogl'); return; }
    renderer.setPixelRatio(Math.min(devicePixelRatio, 1.75));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 400);

    await Promise.all([document.fonts.load('700 40px "Courier Prime"'), document.fonts.load('800 40px "Archivo"'), document.fonts.load('700 30px "B612 Mono"')]).catch(() => {});

    const desk = new THREE.Mesh(new THREE.PlaneGeometry(400, 400), new THREE.MeshStandardMaterial({ color: 0x080a0e, roughness: 0.75, metalness: 0.2 }));
    desk.rotation.x = -Math.PI / 2; desk.receiveShadow = true; scene.add(desk);

    function tex(w: number, h: number, draw: (g: CanvasRenderingContext2D, w: number, h: number) => void) {
      const c = document.createElement('canvas'); c.width = w; c.height = h;
      draw(c.getContext('2d'), w, h);
      const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = 8; return t;
    }
    function grain(g: CanvasRenderingContext2D, w: number, h: number, a: number) {
      const img = g.getImageData(0, 0, w, h), d = img.data;
      for (let i = 0; i < d.length; i += 4) { const n = (Math.random() - 0.5) * a; d[i] += n; d[i + 1] += n; d[i + 2] += n; }
      g.putImageData(img, 0, 0);
    }
    function stamp(g: CanvasRenderingContext2D, text: string, sub: string | null, x: number, y: number, rot: number, color: string, size: number) {
      g.save(); g.translate(x, y); g.rotate(rot); g.globalAlpha = 0.85; g.strokeStyle = color; g.fillStyle = color;
      g.font = `800 ${size}px "Archivo"`; const tw = g.measureText(text).width;
      g.lineWidth = size * 0.08; g.strokeRect(-tw / 2 - size * 0.35, -size * 0.92, tw + size * 0.7, size * (sub ? 1.7 : 1.25));
      g.textAlign = 'center'; g.fillText(text, 0, 0);
      if (sub) { g.font = `700 ${size * 0.3}px "B612 Mono"`; g.fillText(sub, 0, size * 0.52); }
      g.restore();
    }
    const RED = '#d4432f';
    // Black cover with a red cover-sheet border and a titanium label plate
    const coverTex = tex(1024, 1320, (g, w, h) => {
      g.fillStyle = '#0f131a'; g.fillRect(0, 0, w, h); grain(g, w, h, 10);
      g.strokeStyle = RED; g.lineWidth = 22; g.strokeRect(40, 40, w - 80, h - 80);
      g.lineWidth = 3; g.strokeRect(78, 78, w - 156, h - 156);
      const lg = g.createLinearGradient(0, 150, 0, 360); lg.addColorStop(0, '#d5d9df'); lg.addColorStop(1, '#8b929d');
      g.fillStyle = lg; g.fillRect(130, 150, 620, 210);
      g.fillStyle = '#0b0d11'; g.font = '700 44px "Courier Prime"'; g.fillText('PROJECT OXCART', 160, 222);
      g.font = '400 32px "Courier Prime"'; g.fillText('A-12  S/N 60-6924', 160, 272); g.fillText('ARTICLE 121', 160, 316);
      stamp(g, 'TOP SECRET', null, 640, 600, -0.1, RED, 92);
      g.save(); g.strokeStyle = '#e9e9e4'; g.lineWidth = 6; g.beginPath(); g.moveTo(380, 590); g.lineTo(905, 520); g.stroke(); g.restore();
      stamp(g, 'DECLASSIFIED', 'RELEASED TO THE PUBLIC', 510, 900, 0.08, '#eeeee8', 100);
      g.fillStyle = 'rgba(230,233,238,0.55)'; g.font = '400 24px "B612 Mono"';
      g.fillText('ARTICLE 121 ARCHIVE  ·  COMPILED FROM PUBLIC SOURCES', 130, 1200);
    });
    const innerTex = tex(256, 256, (g, w, h) => { g.fillStyle = '#12161d'; g.fillRect(0, 0, w, h); grain(g, w, h, 8); });
    const memoTex = tex(1020, 1320, (g, w, h) => {
      g.fillStyle = '#e8e8e3'; g.fillRect(0, 0, w, h); grain(g, w, h, 9);
      g.fillStyle = '#16181c'; g.font = '700 34px "Courier Prime"';
      g.fillText('ARTICLE 121 ARCHIVE', 80, 120); g.fillText('FILE SUMMARY: A-12 S/N 60-6924', 80, 168);
      g.fillRect(80, 190, 860, 3);
      g.font = '400 29px "Courier Prime"';
      ['1. First airframe of the A-12 program,', '   known inside the program as Article 121.', '', '2. Left Burbank by road on the night of', '   26 February 1962.', '', '3. Unannounced first hop 25 April 1962,', '   pilot Louis W. Schalk. Official first', '   flight 30 April 1962.', '', '4. 332 flights, 418.2 hours. On display', '   at Blackbird Airpark, Palmdale.', '', 'SOURCE: Robarge, ARCHANGEL (CIA CSI,', '2012), pp. 16, 17, 50.'].forEach((l, i) => g.fillText(l, 80, 250 + i * 46));
      g.fillStyle = '#000'; g.fillRect(560, 1000, 300, 34); g.fillRect(80, 1080, 520, 34);
      stamp(g, 'PUBLIC RECORD', null, 760, 1210, -0.06, RED, 58);
    });

    const W = 23, H = 30, T = 0.12;
    const folder = new THREE.Group(); scene.add(folder);
    const blackBoard = new THREE.MeshStandardMaterial({ map: innerTex, roughness: 0.55, metalness: 0.15 });
    const back = new THREE.Mesh(new THREE.BoxGeometry(W, T, H), blackBoard); back.position.y = T / 2; back.castShadow = back.receiveShadow = true; folder.add(back);
    const tab = new THREE.Mesh(new THREE.BoxGeometry(8, T, 2), new THREE.MeshStandardMaterial({ color: 0xd4432f, roughness: 0.6 })); tab.position.set(4, T / 2, -H / 2 - 1); folder.add(tab);
    const memo = new THREE.Mesh(new THREE.PlaneGeometry(20.4, 26.4), new THREE.MeshStandardMaterial({ map: memoTex, roughness: 0.92 }));
    memo.rotation.x = -Math.PI / 2; memo.rotation.z = 0.02; memo.position.set(0.2, T + 0.02, 0.4); memo.receiveShadow = true; folder.add(memo);
    const photoTex = await new THREE.TextureLoader().loadAsync(host.dataset.photo!);
    photoTex.colorSpace = THREE.SRGBColorSpace; photoTex.anisotropy = 8;
    const print = new THREE.Group();
    const border = new THREE.Mesh(new THREE.BoxGeometry(15.2, 0.05, 11.8), new THREE.MeshStandardMaterial({ color: 0xeeeeea, roughness: 0.5 }));
    const photo = new THREE.Mesh(new THREE.PlaneGeometry(14, 10.4), new THREE.MeshStandardMaterial({ map: photoTex, roughness: 0.25, metalness: 0.05 }));
    photo.rotation.x = -Math.PI / 2; photo.position.y = 0.03; border.castShadow = true; print.add(border, photo);
    print.position.set(5.5, T + 0.25, -5.5); print.rotation.y = -0.16; folder.add(print);
    const clipPath = new THREE.CurvePath(); const P = (x: number, z: number) => new THREE.Vector3(x, 0, z);
    clipPath.add(new THREE.LineCurve3(P(0, 0), P(0, 4.2)));
    clipPath.add(new THREE.QuadraticBezierCurve3(P(0, 4.2), P(0.55, 4.9), P(1.1, 4.2)));
    clipPath.add(new THREE.LineCurve3(P(1.1, 4.2), P(1.1, 0.8)));
    clipPath.add(new THREE.QuadraticBezierCurve3(P(1.1, 0.8), P(0.75, 0.3), P(0.4, 0.8)));
    clipPath.add(new THREE.LineCurve3(P(0.4, 0.8), P(0.4, 3.4)));
    const clip = new THREE.Mesh(new THREE.TubeGeometry(clipPath, 80, 0.07, 8), new THREE.MeshStandardMaterial({ color: 0xc9ced6, metalness: 1, roughness: 0.22 }));
    clip.position.set(-2.4, 0.18, -3.4); clip.castShadow = true; print.add(clip);
    const hinge = new THREE.Group(); hinge.position.set(-W / 2, T, 0); folder.add(hinge);
    const coverFront = new THREE.MeshStandardMaterial({ map: coverTex, roughness: 0.5, metalness: 0.2 });
    const cover = new THREE.Mesh(new THREE.BoxGeometry(W, T, H), [blackBoard, blackBoard, coverFront, blackBoard, blackBoard, blackBoard]);
    cover.position.set(W / 2, T / 2 + 0.35, 0); cover.castShadow = cover.receiveShadow = true; hinge.add(cover);

    scene.add(new THREE.HemisphereLight(0xb8c6dc, 0x050608, 0.45));
    const lamp = new THREE.SpotLight(0xfff1dc, 2400, 170, 0.55, 0.7, 1.5);
    lamp.position.set(-16, 48, 18); lamp.castShadow = true; lamp.shadow.mapSize.set(2048, 2048); lamp.shadow.bias = -0.0004;
    scene.add(lamp, lamp.target);
    const rim = new THREE.DirectionalLight(0x7fa0d0, 0.6); rim.position.set(30, 20, -40); scene.add(rim);

    let w = 0, h = 0, aimX = 4, aimZ = -2, visible = false, openAt: number | null = null, running = false;
    function resize() {
      w = host.clientWidth; h = host.clientHeight; renderer.setSize(w, h, false);
      camera.aspect = w / h;
      const narrow = w < 560;
      camera.position.set(narrow ? 4 : 8, narrow ? 70 : 56, narrow ? 34 : 32);
      camera.lookAt(narrow ? -4 : -2, 0, 0);
      camera.updateProjectionMatrix();
    }
    new ResizeObserver(resize).observe(host); resize();
    host.addEventListener('pointermove', (e) => {
      const r = host.getBoundingClientRect();
      aimX = ((e.clientX - r.left) / r.width - 0.5) * 50; aimZ = ((e.clientY - r.top) / r.height - 0.5) * 36;
    });
    // Open the folder when it comes into view; render only while visible
    new IntersectionObserver(([en]: IntersectionObserverEntry[]) => {
      visible = en.isIntersecting;
      if (visible && openAt === null) openAt = performance.now() + 250;
      if (visible && !running) { running = true; requestAnimationFrame(frame); }
    }, { threshold: 0.3 }).observe(host);

    const OPEN = Math.PI * 0.94;

    folder.position.x = 6;
    function frame(now: number) {
      const k = reduce ? 1 : openAt === null ? 0 : THREE.MathUtils.smoothstep(now - openAt, 0, 2200);
      hinge.rotation.z = OPEN * k;
      print.position.x = 5.5 + 1.2 * k; print.rotation.y = -0.16 + 0.08 * k;
      lamp.target.position.x += (aimX - lamp.target.position.x) * 0.06;
      lamp.target.position.z += (aimZ - lamp.target.position.z) * 0.06;
      renderer.render(scene, camera);
      if (visible) requestAnimationFrame(frame); else running = false;
    }
    renderer.render(scene, camera);
    host.dataset.ready = '1';
  }
</script>
