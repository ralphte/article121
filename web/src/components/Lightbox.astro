---
// Full-screen viewer for any .photo on the page. Select once to open, again to zoom.
---
<dialog class="lightbox" id="lightbox" aria-label="Photograph">
  <div class="zoomwrap"><img alt="" /></div>
  <div class="lb-bar"><span class="lb-cap"></span><button class="btn" type="button" data-close>Close</button></div>
</dialog>
<style>
  dialog.lightbox { width: 100vw; height: 100vh; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(2, 3, 5, 0.97); color: var(--ink); }
  dialog.lightbox:not([open]) { display: none !important; }
  dialog.lightbox[open] { display: grid; grid-template-rows: minmax(0, 1fr) auto; position: fixed; inset: 0; }
  dialog::backdrop { background: rgba(0, 0, 0, 0.8); }
  .zoomwrap { overflow: hidden; cursor: zoom-in; min-height: 0; }
  .zoomwrap.zoomed { cursor: zoom-out; touch-action: none; }   /* zoomed: a drag moves around the image */
  .zoomwrap img { width: 100%; height: 100%; object-fit: contain; display: block; transition: transform 0.3s ease; }
  .zoomwrap.zoomed img { transform: scale(2.6); }
  .lb-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--seam); font-size: 0.84rem; color: var(--ink-2); }
  .lb-cap :global(.label) { display: block; margin-top: 4px; }
</style>
<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const wrap = dlg.querySelector('.zoomwrap') as HTMLElement;
    const img = wrap.querySelector('img') as HTMLImageElement;
    const cap = dlg.querySelector('.lb-cap') as HTMLElement;
    const largest = (fig: HTMLElement) => {
      if (fig.dataset.full) return fig.dataset.full;
      const sources = [...fig.querySelectorAll('source, img')].map((s) => (s as HTMLSourceElement).srcset || (s as HTMLImageElement).src);
      const all = sources.join(',').split(',').map((s) => s.trim().split(/\s+/)).filter((p) => p[0]);
      all.sort((a, b) => parseInt(b[1] || '0') - parseInt(a[1] || '0'));
      return all[0]?.[0] ?? (fig.querySelector('img') as HTMLImageElement).currentSrc;
    };
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.photo .open');
      if (!btn) return;
      const fig = btn.closest('.photo') as HTMLElement;
      img.src = largest(fig);
      img.alt = fig.dataset.caption || '';
      cap.textContent = fig.dataset.caption || '';
      const meta = document.createElement('span'); meta.className = 'label'; meta.textContent = fig.dataset.credit || '';
      const a = document.createElement('a'); a.href = fig.dataset.source || '#'; a.textContent = ' Source'; meta.append(a);
      cap.append(meta);
      wrap.classList.remove('zoomed');
      dlg.showModal();
    });
    const origin = (e: MouseEvent) => { const r = wrap.getBoundingClientRect(); img.style.transformOrigin = `${((e.clientX - r.left) / r.width) * 100}% ${((e.clientY - r.top) / r.height) * 100}%`; };
    wrap.addEventListener('click', (e) => { origin(e); wrap.classList.toggle('zoomed'); });
    wrap.addEventListener('pointermove', (e) => { if (wrap.classList.contains('zoomed')) origin(e); });
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
  }
</script>
