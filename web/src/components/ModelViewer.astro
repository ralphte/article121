---
// The 3D SR-71A: Article 121's model, rebuilt from NASA's three-view and a Lockheed section drawing,
// rendered live with three.js. A Cycles render from the same opening camera stands in while it
// loads, and stays if WebGL is unavailable. Materials are dressed by the names the builder gives.
//
// The model is built from named parts (glTF extras a121_part, a121_layer, a121_explode,
// a121_accuracy). The reader can switch layers, see through the skin (x-ray), cut the near half
// away, pull the parts apart, and select any part to read what it is and where that comes from.
import { Picture } from 'astro:assets';
import poster from '../assets/model/sr71a-hero.jpg';
interface PartInfo { title: string; text: string; marksHtml: string }
interface Props { src: string; env: string; size: string; parts: Record<string, PartInfo>; layers: { id: string; name: string }[] }
const { src, env, size, parts, layers } = Astro.props;
const VIEWS: [string, string][] = [['hero', 'Three-quarter'], ['nose', 'Nose on'], ['side', 'Side'], ['top', 'Plan'], ['rear', 'Rear'], ['cockpit', 'Cockpit']];
const HOTSPOTS: [string, string, string][] = [['inlet', 'Inlet spike', '#inlet'], ['cockpit', 'Cockpits', '#cockpits'], ['exhaust', 'J58 and ejector', '#j58'], ['skin', 'Titanium skin', '#heat']];
---
<figure class="mv" data-mv data-src={src} data-env={env}>
  <script type="application/json" data-mv-parts set:html={JSON.stringify({ parts, layers })} />
  <div class="mv-stage">
    <Picture class="mv-poster" src={poster} alt="Render of the Article 121 SR-71A model from the front left, against black" widths={[800, 1200, 1600, 2400]} sizes="(max-width: 1240px) 100vw, 1240px" formats={['avif', 'webp']} loading="eager" />
    <canvas class="mv-canvas" role="img" aria-label="Interactive 3D model of the SR-71A. Drag to turn it, scroll or pinch to zoom, select a part to read about it."></canvas>
    <div class="mv-hots" aria-hidden="false">
      {HOTSPOTS.map(([id, label, href]) => <a class="mv-hot" data-hot={id} href={href} hidden><i></i><span>{label}</span></a>)}
    </div>
    <aside class="mv-info" data-info hidden aria-live="polite">
      <div class="mv-info-head"><span class="label" data-info-layer></span><button type="button" class="mv-x" data-info-close aria-label="Close">×</button></div>
      <h3 data-info-title></h3>
      <p data-info-text></p>
      <p class="mv-acc" data-info-acc></p>
    </aside>
    <p class="mv-status label" data-status>Loading the 3D model ({size})</p>
  </div>
  <div class="mv-bar">
    <div class="mv-row">
      <div class="mv-group" role="group" aria-label="Views">
        {VIEWS.map(([id, label], i) => <button type="button" class="chip" data-view={id} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>)}
      </div>
      <div class="mv-group">
        <button type="button" class="chip" data-labels aria-pressed="true">Labels</button>
        <button type="button" class="chip" data-spin aria-pressed="false">Turntable</button>
      </div>
    </div>
    <div class="mv-row">
      <div class="mv-group" role="group" aria-label="Look inside">
        <button type="button" class="chip" data-xray aria-pressed="false">X-ray</button>
        <button type="button" class="chip" data-cut aria-pressed="false">Cutaway</button>
        <label class="mv-slider"><span class="label">Explode</span><input type="range" min="0" max="1" step="0.01" value="0" data-explode aria-label="Explode the parts apart" /></label>
      </div>
      <div class="mv-group" role="group" aria-label="Layers" data-layers></div>
    </div>
  </div>
  <figcaption>
    <slot />
  </figcaption>
</figure>

<style>
  .mv { margin: 0; border: 1px solid var(--seam-2); background: var(--void); }
  .mv-stage { position: relative; aspect-ratio: 16 / 9; overflow: hidden; touch-action: none; }
  .mv-stage :global(.mv-poster), .mv-stage :global(.mv-poster img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 0.8s ease; }
  .mv-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 0.8s ease; cursor: grab; }
  .mv-canvas:active { cursor: grabbing; }
  [data-mv][data-ready] .mv-canvas { opacity: 1; }
  [data-mv][data-ready] :global(.mv-poster) { opacity: 0; }
  .mv-status { position: absolute; left: 14px; bottom: 10px; margin: 0; color: var(--ink-3); }
  [data-mv][data-ready] .mv-status { display: none; }
  .mv-hots { position: absolute; inset: 0; pointer-events: none; }
  .mv-hot {
    position: absolute; left: 0; top: 0; pointer-events: auto; display: inline-flex; align-items: center; gap: 8px;
    font: 700 0.62rem/1 var(--f-data); letter-spacing: 0.14em; text-transform: uppercase; color: var(--stencil);
    text-decoration: none; transition: opacity 0.25s; white-space: nowrap;
  }
  .mv-hot i { width: 9px; height: 9px; border-radius: 50%; background: var(--marking); box-shadow: 0 0 0 3px rgba(212, 67, 47, 0.28); flex: none; }
  .mv-hot span { background: rgba(5, 7, 10, 0.72); border: 1px solid var(--seam-2); padding: 5px 7px; }
  .mv-hot:hover span, .mv-hot:focus-visible span { border-color: var(--marking); }
  .mv-hot.behind { opacity: 0; pointer-events: none; }
  .mv-info {
    position: absolute; right: 12px; top: 12px; width: min(340px, calc(100% - 24px)); max-height: calc(100% - 24px); overflow: auto;
    background: rgba(8, 11, 16, 0.9); border: 1px solid var(--seam-2); border-left: 3px solid var(--marking); padding: 12px 14px; backdrop-filter: blur(4px);
  }
  .mv-info-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .mv-x { all: unset; cursor: pointer; font: 400 1.2rem/1 var(--f-body); color: var(--ink-2); padding: 0 4px; }
  .mv-x:hover, .mv-x:focus-visible { color: var(--stencil); }
  .mv-info h3 { font: 700 1.05rem/1.25 var(--f-display); font-stretch: 110%; color: var(--stencil); margin: 6px 0 6px; text-transform: uppercase; letter-spacing: 0.02em; }
  .mv-info p { margin: 0 0 8px; font-size: 0.86rem; line-height: 1.5; color: var(--ink); }
  .mv-info .mv-acc { font: 400 0.64rem/1.4 var(--f-data); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); margin: 0; }
  .mv-bar { display: grid; gap: 8px; padding: 12px 14px; border-top: 1px solid var(--seam); }
  .mv-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 14px; }
  .mv-group { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .mv-slider { display: inline-flex; align-items: center; gap: 8px; padding: 0 4px; }
  .mv-slider input { width: 130px; accent-color: var(--marking); }
  .chip[disabled] { opacity: 0.35; cursor: not-allowed; }
  figcaption { padding: 0 14px 14px; font-size: 0.86rem; line-height: 1.55; color: var(--ink-2); }
  figcaption :global(p) { margin: 0 0 8px; max-width: 78ch; }
  @media (max-width: 640px) {
    .mv-stage { aspect-ratio: 4 / 3; }
    .mv-hot span { display: none; }
    .mv-info { left: 8px; right: 8px; top: auto; bottom: 8px; width: auto; max-height: 55%; }
  }
</style>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { HDRLoader } from 'three/examples/jsm/loaders/HDRLoader.js';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { RectAreaLightUniformsLib } from 'three/examples/jsm/lights/RectAreaLightUniformsLib.js';
  import { MeshoptDecoder } from 'three/examples/jsm/libs/meshopt_decoder.module.js';

  // Cameras in the model's frame (x aft is negative, y up, z to the left wing), with the horizontal
  // field of view of the lens each Cycles still was rendered with, so "hero" matches the poster.
  const hfov = (mm: number) => 2 * Math.atan(18 / mm);
  const VIEWS: Record<string, { pos: [number, number, number]; target: [number, number, number]; hfov: number }> = {
    hero: { pos: [13, 6.5, 21], target: [-16, 0.5, 0], hfov: hfov(42) },
    nose: { pos: [22, 2.6, 0.001], target: [-14, 0.6, 0], hfov: hfov(85) },
    side: { pos: [-15.6, 0.9, 62], target: [-15.6, 0.9, 0], hfov: hfov(55) },
    top: { pos: [-15.6, 70, 0.01], target: [-15.6, 0, 0], hfov: hfov(45) },
    rear: { pos: [-50, 4.5, -15], target: [-17, 0.6, 0], hfov: hfov(50) },
    cockpit: { pos: [1.5, 2.9, 5.2], target: [-6, 0.9, 0], hfov: hfov(50) },
  };
  // Hotspot anchors on the airframe (right side, facing the opening view): spike tip, canopy, ejector, a chine panel
  const HOTS: Record<string, [number, number, number]> = {
    inlet: [-15.17, 0.07, 3.99], cockpit: [-5.0, 1.38, 0], exhaust: [-28.6, 0.65, 4.22], skin: [-9.5, 0.55, 1.25],
  };
  const lin = (r: number, g: number, b: number) => new THREE.Color().setRGB(r, g, b, THREE.LinearSRGBColorSpace);
  const MATERIALS: Record<string, () => THREE.MeshStandardMaterial> = {
    'Blackbird skin': () => new THREE.MeshPhysicalMaterial({ color: lin(0.0105, 0.0118, 0.0155), roughness: 0.34, metalness: 0, clearcoat: 0.25, clearcoatRoughness: 0.18 }),
    'Canopy glass': () => new THREE.MeshPhysicalMaterial({ color: lin(0.012, 0.016, 0.02), roughness: 0.03, metalness: 0, clearcoat: 1, clearcoatRoughness: 0, transparent: true, opacity: 0.55, depthWrite: false }),
    // panel lines: rougher and darker than the paint, so they show where the skin catches the light
    'Panel line': () => new THREE.MeshPhysicalMaterial({ color: lin(0.004, 0.0045, 0.006), roughness: 0.75, metalness: 0, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -2 }),
    'Ejector metal': () => new THREE.MeshPhysicalMaterial({ color: lin(0.26, 0.22, 0.18), roughness: 0.4, metalness: 1 }),
    'Inlet duct': () => new THREE.MeshStandardMaterial({ color: lin(0.006, 0.006, 0.007), roughness: 0.75 }),
    'Intake and nozzle': () => new THREE.MeshStandardMaterial({ color: lin(0.006, 0.006, 0.007), roughness: 0.75 }),
    'Engine metal': () => new THREE.MeshPhysicalMaterial({ color: lin(0.42, 0.43, 0.45), roughness: 0.32, metalness: 1 }),
    'Engine hot section': () => new THREE.MeshPhysicalMaterial({ color: lin(0.36, 0.26, 0.17), roughness: 0.4, metalness: 1 }),
    'Frame': () => new THREE.MeshStandardMaterial({ color: lin(0.55, 0.58, 0.62), roughness: 0.45, metalness: 0.9 }),
    'Fuel tank': () => new THREE.MeshStandardMaterial({ color: lin(0.85, 0.5, 0.1), roughness: 0.35, metalness: 0, transparent: true, opacity: 0.55, depthWrite: false }),
    'Bay': () => new THREE.MeshStandardMaterial({ color: lin(0.12, 0.45, 0.7), roughness: 0.4, metalness: 0, transparent: true, opacity: 0.5, depthWrite: false }),
    'Seat': () => new THREE.MeshStandardMaterial({ color: lin(0.09, 0.1, 0.08), roughness: 0.7 }),
    'Cockpit': () => new THREE.MeshStandardMaterial({ color: lin(0.028, 0.03, 0.032), roughness: 0.7 }),
    'Panel': () => new THREE.MeshStandardMaterial({ color: lin(0.02, 0.02, 0.025), roughness: 0.5 }),
    'Tyre': () => new THREE.MeshStandardMaterial({ color: lin(0.03, 0.03, 0.03), roughness: 0.85 }),
    'Marker': () => new THREE.MeshStandardMaterial({ color: lin(0.83, 0.26, 0.18), roughness: 0.5, emissive: lin(0.2, 0.04, 0.02) }),
  };
  // X-ray: a fresnel rim, bright where the skin turns away from the eye, nearly clear face-on
  const xrayMaterial = (clip: THREE.Plane[]) => new THREE.ShaderMaterial({
    uniforms: { tint: { value: new THREE.Color(0x8fb4e6) }, strength: { value: 0.85 } },
    vertexShader: `
      #include <clipping_planes_pars_vertex>
      varying vec3 vN; varying vec3 vV;
      void main() {
        vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);   // the name the clipping chunk reads
        vN = normalize(normalMatrix * normal); vV = normalize(-mvPosition.xyz);
        gl_Position = projectionMatrix * mvPosition;
        #include <clipping_planes_vertex>
      }`,
    fragmentShader: `
      #include <clipping_planes_pars_fragment>
      uniform vec3 tint; uniform float strength; varying vec3 vN; varying vec3 vV;
      void main() {
        #include <clipping_planes_fragment>
        float rim = pow(1.0 - abs(dot(normalize(vN), normalize(vV))), 2.2);
        gl_FragColor = vec4(tint * (0.04 + rim * strength), 0.08 + rim * 0.55);
      }`,
    transparent: true, depthWrite: false, side: THREE.DoubleSide, blending: THREE.AdditiveBlending, clipping: true, clippingPlanes: clip,
  });

  for (const fig of document.querySelectorAll<HTMLElement>('[data-mv]')) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); start(fig).catch((err) => fail(fig, err)); }
    }, { rootMargin: '300px' });
    io.observe(fig);
  }

  function fail(fig: HTMLElement, err: unknown) {
    console.error(err);
    const s = fig.querySelector('[data-status]');
    if (s) s.textContent = 'The 3D view could not start here; this is a render of the same model.';
    fig.dataset.error = '1';
  }

  type Part = { id: string; obj: THREE.Object3D; base: THREE.Vector3; vec: THREE.Vector3; layer: string; accuracy: string; meshes: THREE.Mesh[] };

  async function start(fig: HTMLElement) {
    const canvas = fig.querySelector<HTMLCanvasElement>('.mv-canvas')!;
    const stage = fig.querySelector<HTMLElement>('.mv-stage')!;
    const status = fig.querySelector('[data-status]')!;
    const info = JSON.parse(fig.querySelector('[data-mv-parts]')!.textContent || '{}') as { parts: Record<string, { title: string; text: string; marksHtml: string }>; layers: { id: string; name: string }[] };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let dirty = true, visible = true;   // redraw needed; viewer on screen

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.toneMapping = THREE.AgXToneMapping;
    renderer.toneMappingExposure = 0.9;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.setClearColor(0x000000, 0);
    renderer.localClippingEnabled = true;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 16 / 9, 0.1, 400);
    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = !reduce; controls.dampingFactor = 0.08;
    controls.enablePan = false; controls.minDistance = 4; controls.maxDistance = 160;
    controls.autoRotateSpeed = 0.6;

    // light: the same CC0 studio map as the stills (environment only, never seen), plus area lights
    // standing in for the stills' softbox and rim strips
    RectAreaLightUniformsLib.init();
    const pmrem = new THREE.PMREMGenerator(renderer);
    const hdr = await new HDRLoader().loadAsync(fig.dataset.env!);
    scene.environment = pmrem.fromEquirectangular(hdr).texture;
    hdr.dispose(); pmrem.dispose();
    scene.environmentIntensity = 0.2;
    scene.environmentRotation.set(0, THREE.MathUtils.degToRad(35), 0);
    const area = (w: number, h: number, intensity: number, pos: [number, number, number], color = 0xffffff) => {
      const l = new THREE.RectAreaLight(color, intensity, w, h); l.position.set(...pos); l.lookAt(-15, 0, 0); scene.add(l);
    };
    area(22, 9, 2.6, [-14, 22, 0]);
    // soft shadows: a key light where the softbox hangs casts filtered shadow maps, so the wings
    // shade the nacelles, the fins the tail cone, and the cutaway and exploded views show depth
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;
    const key = new THREE.DirectionalLight(0xffffff, 1.3);
    key.position.set(-10, 30, 9); key.target.position.set(-16, 0, 0);
    key.castShadow = true;
    key.shadow.mapSize.set(2048, 2048);
    Object.assign(key.shadow.camera, { left: -32, right: 32, top: 32, bottom: -32, near: 1, far: 90 });
    key.shadow.camera.updateProjectionMatrix();
    key.shadow.radius = 5; key.shadow.bias = -0.0004; key.shadow.normalBias = 0.03;
    scene.add(key, key.target);
    area(36, 2.5, 9, [-34, 7, -24], 0xd1e6ff);
    area(36, 2.5, 9, [-34, 7, 24], 0xd1e6ff);
    area(10, 4, 0.6, [26, 2, 10], 0xffeed9);

    const loader = new GLTFLoader();
    loader.setMeshoptDecoder(MeshoptDecoder);
    const gltf = await loader.loadAsync(fig.dataset.src!);

    // the cutaway removes the near (right) half of the skin: keep z < 0
    const cutPlane = new THREE.Plane(new THREE.Vector3(0, 0, -1), 0);
    const noClip: THREE.Plane[] = [];
    const clipList: THREE.Plane[] = [];          // shared array: holds cutPlane while the cutaway is on
    const xray = xrayMaterial(clipList);

    // the cutaway cuts the skin and the cockpit tubs (shells), never the parts inside them
    const clipped = (p: Part) => p.layer === 'skin' || p.id.startsWith('cockpit-');
    // parts: the node that carries a121_part, with every mesh under it
    const parts: Part[] = [];
    const partOf = new Map<THREE.Object3D, Part>();
    gltf.scene.traverse((o) => {
      const ud = o.userData as { a121_part?: string; a121_layer?: string; a121_explode?: number[]; a121_accuracy?: string };
      if (ud.a121_part) {
        const p: Part = { id: ud.a121_part, obj: o, base: o.position.clone(), vec: new THREE.Vector3(...(ud.a121_explode ?? [0, 0, 0])), layer: ud.a121_layer ?? 'skin', accuracy: ud.a121_accuracy ?? 'measured', meshes: [] };
        parts.push(p);
      }
    });
    for (const p of parts) {
      p.obj.traverse((o) => {
        const m = o as THREE.Mesh;
        if (!m.isMesh) return;
        const swap = (mat: THREE.Material) => {
          const nm = MATERIALS[mat.name] ? MATERIALS[mat.name]() : (mat as THREE.MeshStandardMaterial);
          nm.side = THREE.DoubleSide;   // mirrored parts carry flipped winding
          if (mat.name.startsWith('Marking')) { nm.polygonOffset = true; nm.polygonOffsetFactor = -3; nm.polygonOffsetUnits = -3; }
          if (nm.emissive) nm.userData.emissive = { color: nm.emissive.clone(), intensity: nm.emissiveIntensity };
          nm.clippingPlanes = clipped(p) ? clipList : noClip;
          return nm;
        };
        m.material = Array.isArray(m.material) ? m.material.map(swap) : swap(m.material);
        m.userData.solid = m.material;
        m.castShadow = ![m.material].flat().some((x) => x.transparent);
        m.receiveShadow = true;
        p.meshes.push(m);
        partOf.set(m, p);
      });
    }
    scene.add(gltf.scene);

    // layers: buttons for the layers this model actually has
    const present = new Set(parts.map((p) => p.layer));
    const layerOn: Record<string, boolean> = {};
    const layerBox = fig.querySelector<HTMLElement>('[data-layers]')!;
    for (const l of info.layers) {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'chip'; b.textContent = l.name;
      b.setAttribute('aria-pressed', present.has(l.id) ? 'true' : 'false');
      if (!present.has(l.id)) { b.disabled = true; b.title = 'Not modelled yet'; }
      layerOn[l.id] = present.has(l.id);
      b.addEventListener('click', () => {
        layerOn[l.id] = !layerOn[l.id];
        b.setAttribute('aria-pressed', String(layerOn[l.id]));
        for (const p of parts) if (p.layer === l.id) p.obj.visible = layerOn[l.id];
        dirty = true;
      });
      layerBox.appendChild(b);
    }

    // x-ray and cutaway
    let xrayOn = false;
    const applyLook = () => {
      for (const p of parts) for (const m of p.meshes) {
        m.material = xrayOn && p.layer === 'skin' ? xray : m.userData.solid;
        m.renderOrder = xrayOn && p.layer === 'skin' ? 2 : 0;
        m.castShadow = !(xrayOn && p.layer === 'skin') && ![m.userData.solid].flat().some((x: THREE.Material) => x.transparent);
      }
      dirty = true;
    };
    const xrayBtn = fig.querySelector<HTMLButtonElement>('[data-xray]')!;
    xrayBtn.addEventListener('click', () => { xrayOn = !xrayOn; xrayBtn.setAttribute('aria-pressed', String(xrayOn)); applyLook(); });
    const cutBtn = fig.querySelector<HTMLButtonElement>('[data-cut]')!;
    cutBtn.addEventListener('click', () => {
      const on = clipList.length === 0;
      clipList.length = 0; if (on) clipList.push(cutPlane);
      cutBtn.setAttribute('aria-pressed', String(on));
      // materials cache their clipping state: force a recompile
      for (const p of parts) for (const m of p.meshes) for (const mt of [m.material].flat()) mt.needsUpdate = true;
      xray.needsUpdate = true;
      dirty = true;
    });

    // explode
    let explode = 0, explodeTarget = 0;
    const exInput = fig.querySelector<HTMLInputElement>('[data-explode]')!;
    exInput.addEventListener('input', () => { explodeTarget = parseFloat(exInput.value); if (reduce) explode = explodeTarget; dirty = true; });
    const applyExplode = () => { for (const p of parts) p.obj.position.copy(p.base).addScaledVector(p.vec, explode); };

    // selection
    const infoBox = fig.querySelector<HTMLElement>('[data-info]')!;
    let selected: Part | null = null;
    const highlight = (p: Part | null, on: boolean) => {
      if (!p) return;
      for (const m of p.meshes) for (const mt of [m.userData.solid as THREE.Material].flat()) {
        const s = mt as THREE.MeshStandardMaterial;
        const e0 = s.userData.emissive as { color: THREE.Color; intensity: number } | undefined;
        if (s.emissive) { if (on) { s.emissive.set(0xd4432f); s.emissiveIntensity = 0.35; } else if (e0) { s.emissive.copy(e0.color); s.emissiveIntensity = e0.intensity; } }
      }
    };
    const select = (p: Part | null) => {
      highlight(selected, false); selected = p; highlight(p, true);
      if (!p) { infoBox.hidden = true; dirty = true; return; }
      const d = info.parts[p.id];
      fig.querySelector('[data-info-title]')!.textContent = d?.title ?? p.id;
      fig.querySelector('[data-info-text]')!.innerHTML = d ? `${d.text}${d.marksHtml}` : '';
      fig.querySelector('[data-info-layer]')!.textContent = info.layers.find((l) => l.id === p.layer)?.name ?? p.layer;
      fig.querySelector('[data-info-acc]')!.textContent = p.accuracy === 'representative'
        ? 'Representative shape: placed from the sources, not measured from a drawing'
        : 'Measured from NASA and Lockheed drawings';
      infoBox.hidden = false; dirty = true;
    };
    fig.querySelector('[data-info-close]')!.addEventListener('click', () => select(null));
    const ray = new THREE.Raycaster();
    let down: { x: number; y: number } | null = null;
    canvas.addEventListener('pointerdown', (e) => { down = { x: e.clientX, y: e.clientY }; });
    canvas.addEventListener('pointerup', (e) => {
      if (!down || Math.hypot(e.clientX - down.x, e.clientY - down.y) > 5) { down = null; return; }
      down = null;
      const r = canvas.getBoundingClientRect();
      ray.setFromCamera(new THREE.Vector2(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1), camera);
      const hits = ray.intersectObjects(parts.filter((p) => p.obj.visible).flatMap((p) => p.meshes), false)
        .filter((h) => { const q = partOf.get(h.object as THREE.Mesh); return !(clipList.length && q && clipped(q) && cutPlane.distanceToPoint(h.point) < 0); })
        .filter((h) => !(xrayOn && partOf.get(h.object as THREE.Mesh)?.layer === 'skin' && parts.some((p) => p.layer !== 'skin' && p.obj.visible)));
      select(hits.length ? partOf.get(hits[0].object as THREE.Mesh) ?? null : null);
    });

    // camera moves between views; the field of view keeps the still's horizontal coverage
    let hf = VIEWS.hero.hfov;
    const setFov = () => { camera.fov = THREE.MathUtils.radToDeg(2 * Math.atan(Math.tan(hf / 2) / camera.aspect)); camera.updateProjectionMatrix(); };
    const place = (v: typeof VIEWS[string]) => { camera.position.set(...v.pos); controls.target.set(...v.target); hf = v.hfov; setFov(); controls.update(); };
    place(VIEWS.hero);
    let anim: null | { t0: number; from: { p: THREE.Vector3; t: THREE.Vector3; h: number }; to: typeof VIEWS[string] } = null;
    const go = (name: string) => {
      fig.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === name)));
      if (reduce) { place(VIEWS[name]); dirty = true; return; }
      anim = { t0: performance.now(), from: { p: camera.position.clone(), t: controls.target.clone(), h: hf }, to: VIEWS[name] };
    };
    fig.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => go(b.dataset.view!)));
    const labelsBtn = fig.querySelector<HTMLButtonElement>('[data-labels]')!;
    let labels = true;
    labelsBtn.addEventListener('click', () => { labels = !labels; labelsBtn.setAttribute('aria-pressed', String(labels)); dirty = true; });
    const spinBtn = fig.querySelector<HTMLButtonElement>('[data-spin]')!;
    if (reduce) spinBtn.hidden = true;
    spinBtn.addEventListener('click', () => { controls.autoRotate = !controls.autoRotate; spinBtn.setAttribute('aria-pressed', String(controls.autoRotate)); });

    const resize = () => {
      const w = stage.clientWidth, h = stage.clientHeight;
      renderer.setSize(w, h, false); camera.aspect = w / h; setFov(); dirty = true;
    };
    new ResizeObserver(resize).observe(stage);
    resize();

    // hotspots: projected each frame; hidden when the airframe is between them and the camera,
    // and while the parts are pulled apart
    const hots = [...fig.querySelectorAll<HTMLElement>('[data-hot]')];
    const hotRay = new THREE.Raycaster();
    const v3 = new THREE.Vector3();
    let lastCheck = 0;
    function placeHots(now: number) {
      const w = stage.clientWidth, h = stage.clientHeight;
      const show = labels && explode < 0.02 && !xrayOn;
      const occlusion = now - lastCheck > 120;
      if (occlusion) lastCheck = now;
      for (const el of hots) {
        el.hidden = !show;
        if (!show) continue;
        const p = new THREE.Vector3(...HOTS[el.dataset.hot!]);
        v3.copy(p).project(camera);
        const onScreen = v3.z < 1 && Math.abs(v3.x) < 1.02 && Math.abs(v3.y) < 1.02;
        el.style.transform = `translate(${((v3.x + 1) / 2 * w - 4).toFixed(1)}px, ${((1 - v3.y) / 2 * h - 4).toFixed(1)}px)`;
        if (occlusion) {
          const dir = p.clone().sub(camera.position); const dist = dir.length();
          hotRay.set(camera.position, dir.normalize()); hotRay.far = dist - 0.25;
          el.classList.toggle('behind', !onScreen || hotRay.intersectObjects(parts.flatMap((q) => q.meshes), false).length > 0);
        }
      }
    }

    new IntersectionObserver((e) => { visible = e.some((x) => x.isIntersecting); }).observe(fig);
    controls.addEventListener('change', () => { dirty = true; });
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    function frame(now: number) {
      requestAnimationFrame(frame);
      if (!visible) return;
      if (anim) {
        const k = Math.min(1, (now - anim.t0) / 1100), e = ease(k);
        camera.position.lerpVectors(anim.from.p, new THREE.Vector3(...anim.to.pos), e);
        controls.target.lerpVectors(anim.from.t, new THREE.Vector3(...anim.to.target), e);
        hf = anim.from.h + (anim.to.hfov - anim.from.h) * e; setFov();
        if (k >= 1) anim = null;
        dirty = true;
      }
      if (explode !== explodeTarget) {
        const prev = explode;
        explode = Math.abs(explode - explodeTarget) > 1e-3 ? explode + (explodeTarget - explode) * 0.18 : explodeTarget;
        // pull the camera back as the parts spread, so the exploded aircraft stays in frame
        const k = (1 + 0.75 * explode) / (1 + 0.75 * prev);
        camera.position.sub(controls.target).multiplyScalar(k).add(controls.target);
        dirty = true;
      }
      if (controls.update() || controls.autoRotate) dirty = true;
      if (!dirty) return;
      dirty = false;
      applyExplode();
      renderer.render(scene, camera);
      placeHots(now);
    }
    requestAnimationFrame(frame);
    (fig as HTMLElement & { mv?: unknown }).mv = { camera, controls, renderer, parts, select };   // for tests and the console
    fig.dataset.ready = '1';
  }
</script>
