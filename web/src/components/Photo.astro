---
// One photograph with its full credit: creator, date, licence (linked) and source.
import { Picture } from 'astro:assets';
import type { Photo } from '../lib/data';
interface Props { photo: Photo; sizes?: string; frame?: string; eager?: boolean; }
const { photo, sizes = '(max-width: 900px) 100vw, 640px', frame, eager = false } = Astro.props;
const p = photo.data;
const full = p.master ?? null;
---
<figure class="photo" data-full={full ?? undefined} data-caption={p.caption} data-credit={`${p.creator}${p.date ? ' · ' + p.date : ''} · ${p.license}`} data-source={p.source_page}>
  <div class="shot">
    <Picture src={p.file} alt={p.caption} widths={[480, 800, 1200, 1600]} sizes={sizes} formats={['avif', 'webp']} loading={eager ? 'eager' : 'lazy'} />
    {frame && <span class="no">{frame}</span>}
    <button class="open" type="button" aria-label={`View full screen: ${p.caption}`}></button>
  </div>
  <figcaption>
    {p.caption}
    <span class="credit">{p.creator}{p.date && ` · ${p.date}`}{p.original_id && ` · ${p.original_id}`} · {p.license_url ? <a href={p.license_url}>{p.license}</a> : p.license} · <a href={p.source_page}>Source</a></span>
  </figcaption>
</figure>
<style>
  .photo { margin: 0; background: var(--hull); border: 1px solid var(--seam); display: grid; grid-template-rows: auto 1fr; }
  .shot { position: relative; overflow: hidden; background: var(--void); }
  .shot :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; transition: transform 0.6s cubic-bezier(.2,.7,.2,1); }
  .photo:hover .shot :global(img) { transform: scale(1.03); }
  .no { position: absolute; left: 10px; top: 8px; font: 700 0.6rem/1 var(--f-data); letter-spacing: 0.16em; color: var(--stencil); background: rgba(5,7,10,0.7); padding: 5px 7px; }
  .open { all: unset; position: absolute; inset: 0; cursor: zoom-in; }
  .open:focus-visible { outline: 2px solid var(--marking); outline-offset: -2px; }
  figcaption { padding: 12px 14px 14px; font-size: 0.86rem; line-height: 1.45; display: grid; gap: 6px; align-content: start; color: var(--ink); }
  .credit { font: 400 0.6rem/1.5 var(--f-data); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .credit a { color: var(--ink-2); }
  @media (prefers-reduced-motion: reduce) { .shot :global(img) { transition: none; } }
</style>
