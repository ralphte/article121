---
import Base from '../layouts/Base.astro';
---
<Base title="File not found">
  <div class="wrap">
    <header class="page-head panel ticks">
      <div class="file-head"><b>File A121-404</b><span>Not in the archive</span></div>
      <h1 class="display">File not found</h1>
      <div class="stamp">No record<small>Check the reference</small></div>
      <p style="margin-top:22px">There is no file at this address. It may have moved, or the link may be mistyped.</p>
      <p><a class="btn solid" href="/">Back to the file</a> <a class="btn" href="/register/">Open the register</a></p>
    </header>
  </div>
</Base>
