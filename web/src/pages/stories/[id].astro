---
// One story: headline, lead picture, the story in cited paragraphs, the other pictures beside it,
// and for a legend the verdict first. Sources are numbered in order of first use on the page.
import Base from '../../layouts/Base.astro';
import EventMedia from '../../components/EventMedia.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getCollection } from 'astro:content';
import { fmtDate, leadOf, mediaByStory, PROGRAM_LABEL, sourceHref, storiesInOrder, type Story } from '../../lib/data';
import { pageCitations } from '../../lib/cites';

export async function getStaticPaths() {
  const all = await storiesInOrder();
  return all.map((s, i) => ({ params: { id: s.id }, props: { story: s, prev: all[i - 1] ?? null, next: all[i + 1] ?? null } }));
}
interface Props { story: Story; prev: Story | null; next: Story | null }
const { story, prev, next } = Astro.props;
const d = story.data;
const { marks, supHtml, list } = pageCitations();
const verdict = d.verdict ? { text: d.verdict.text, sup: supHtml(await marks(d.verdict.citations)) } : null;
const body = [];
for (const p of d.body) body.push({ text: p.text, sup: supHtml(await marks(p.citations)) });
const differ = d.differ ? { text: d.differ.text, sup: supHtml(await marks(d.differ.citations)) } : null;
const used = list();
const items = (await mediaByStory()).get(story.id) ?? [];
const lead = leadOf(items);
const rest = items.filter((m) => m !== lead);
const airframeIds = new Set((await getCollection('airframes')).map((a) => a.id));
---
<Base wide title={d.title} description={d.dek}>
  <div class="wrap fluid">
    <article class="story panel ticks">
      <header>
        <div class="file-head"><b><a href="/stories/">Stories</a></b><span>{fmtDate(d.date, d.precision)}</span><span>{d.programs.map((p) => PROGRAM_LABEL[p]).join(' · ')}</span></div>
        {d.kind === 'legend' && <span class="stamp land legend">Legend<small>checked</small></span>}
        <h1 class="display">{d.title}</h1>
        <p class="dek">{d.dek}</p>
        {(d.airframes.length > 0 || d.people.length > 0) && (
          <p class="who">
            {d.airframes.map((s) => airframeIds.has(s) ? <a class="af" href={`/register/${s}/`}>{s}</a> : <span class="af">{s}</span>)}
            {d.people.length > 0 && <span class="people">{d.people.join(' · ')}</span>}
          </p>
        )}
      </header>

      {lead && <div class="lead"><EventMedia item={lead} lead sizes="(max-width: 1200px) 100vw, 1400px" /></div>}

      {verdict && (
        <section class="verdict" aria-label="What the record shows">
          <h2 class="label">What the record shows</h2>
          <p>{verdict.text}<Fragment set:html={verdict.sup} /></p>
        </section>
      )}

      <div class="cols">
        <div class="text">
          {body.map((p) => <p>{p.text}<Fragment set:html={p.sup} /></p>)}
          {differ && <p class="note"><b>Where sources differ:</b> {differ.text}<Fragment set:html={differ.sup} /></p>}
        </div>
        {rest.length > 0 && (
          <aside class="gallery" aria-label="Pictures and documents">
            {rest.map((m) => <EventMedia item={m} sizes="(max-width: 1200px) 50vw, 420px" />)}
          </aside>
        )}
      </div>

      <section class="srcs" aria-labelledby="srcs-h">
        <div class="file-head"><b id="srcs-h">Sources for this story</b><span>{used.length}</span></div>
        <ol>
          {used.map(({ entry, n, pages }) => (
            <li id={`src-${n}`}>
              {entry.data.publisher}. <em>{entry.data.title}</em>.{pages.length > 0 && <span class="pp"> Cited at {pages.join('; ')}.</span>}
              {' '}<a href={sourceHref(entry.data)}>{entry.data.offline && entry.data.archive ? 'Archived copy' : 'Open'}</a>
              {entry.data.archive && !entry.data.offline && <> · <a href={entry.data.archive}>Archived</a></>} · <a href={`/sources/#${entry.id}`}>In the register</a>
            </li>
          ))}
        </ol>
      </section>
    </article>

    <nav class="pager" aria-label="More stories">
      {prev ? <a href={`/stories/${prev.id}/`}><span class="label">Earlier</span>{prev.data.title}</a> : <span></span>}
      <a class="all" href="/stories/"><span class="label">All stories</span></a>
      {next ? <a class="nx" href={`/stories/${next.id}/`}><span class="label">Later</span>{next.data.title}</a> : <span></span>}
    </nav>
  </div>
  <Lightbox />
</Base>

<style>
  .story { margin-top: 40px; padding: clamp(18px, 3.6vw, 52px); position: relative; }
  .file-head a { text-decoration: none; color: inherit; }
  @media (pointer: coarse) { .file-head a { display: inline-flex; align-items: center; min-height: 40px; margin-block: -12px; } }
  h1 { font-size: min(clamp(2.2rem, 1.2rem + 4vw, 5rem), calc((100vw - 80px) / 9.8)); margin: 8px 0 16px; max-width: 22ch; overflow-wrap: break-word; }
  .dek { font-size: clamp(1.08rem, 1rem + 0.4vw, 1.35rem); line-height: 1.5; color: var(--ink); max-width: 60ch; margin: 0 0 14px; }
  .legend { position: absolute; right: clamp(18px, 3.6vw, 52px); top: clamp(56px, 6vw, 90px); }
  .who { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 0; }
  .af { font: 700 max(0.66rem, var(--floor))/1 var(--f-data); letter-spacing: 0.08em; padding: 6px 8px; border: 1px solid var(--seam-2); text-decoration: none; color: var(--ink); }
  a.af:hover { border-color: var(--stencil); }
  .people { font-size: 0.86rem; color: var(--ink-2); }
  .lead { margin: 26px 0 0; max-width: 1180px; }
  .lead :global(.shot img) { max-height: min(64vh, 664px); }
  .verdict { margin: 26px 0 0; padding: 18px 20px; border: 1px solid var(--marking); background: var(--marking-soft); max-width: 78ch; }
  .verdict h2 { margin: 0 0 8px; color: var(--marking); }
  .verdict p { margin: 0; font-size: 1.05rem; line-height: 1.6; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; margin-top: 28px; }
  .text p { margin: 0 0 1.1em; max-width: 68ch; font-size: 1.06rem; line-height: 1.7; }
  .text p:first-child::first-letter { font: 800 3.1em/0.8 var(--f-display); float: left; margin: 0.08em 0.1em 0 0; color: var(--stencil); }
  .note { font-size: 0.92rem !important; color: var(--ink-2); border-left: 2px solid var(--marking); padding-left: 12px; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 12px; align-content: start; }
  .srcs { margin-top: 36px; }
  .srcs ol { margin: 0; padding-left: 1.6rem; display: grid; gap: 10px; font-size: 0.9rem; line-height: 1.5; }
  .srcs li { scroll-margin-top: 70px; overflow-wrap: anywhere; }
  .srcs li:target { outline: 1px solid var(--marking); outline-offset: 4px; background: var(--marking-soft); }
  .srcs .pp { color: var(--ink-2); }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; margin-top: 14px; }
  .pager a { display: grid; gap: 4px; padding: 14px 16px; background: var(--hull); border: 1px solid var(--seam); text-decoration: none; color: var(--stencil); font: 700 0.95rem/1.3 var(--f-display); }
  .pager a:hover { border-color: var(--seam-2); }
  .pager .nx { text-align: right; }
  .pager .all { align-content: center; }
  @media (min-width: 1200px) {
    .cols { grid-template-columns: minmax(0, 68ch) minmax(0, 1fr); gap: clamp(32px, 4vw, 80px); }
    .gallery { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); position: sticky; top: 64px; }
  }
  @media (max-width: 700px) {
    .legend { position: static; display: inline-block; margin: 4px 0 10px; }
    .pager { grid-template-columns: 1fr 1fr; }
    .pager .all { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
