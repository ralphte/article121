---
// Stories: the best of the program's stories, each told from the record and cited paragraph by
// paragraph. Content comes from research/stories.json via scripts/import-research.mjs.
import Base from '../../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { fmtDate, leadOf, mediaByStory, mediaImage, PROGRAM_LABEL, storiesInOrder } from '../../lib/data';
const stories = await storiesInOrder();
const media = await mediaByStory();
const legends = stories.filter((s) => s.data.kind === 'legend').length;
---
<Base wide title="Stories" description="The best stories of the A-12, YF-12, D-21 and SR-71 programs, told from the record with every paragraph sourced, and the famous legends checked.">
  <div class="wrap fluid">
    <header class="page-head panel ticks">
      <div class="file-head"><b>File A121-0006</b><span>Stories</span><span>{stories.length} stories · {legends} legends checked</span></div>
      <h1 class="display">Stories</h1>
      <p>The program produced more good stories than most: aircraft that went to their test site by road, crashes that had to be explained away, drones that came down on the wrong side of the world, and a coast-to-coast flight that ended a career. Each is told here from the record, with every paragraph sourced. Where a famous story does not hold up, it is marked as a legend and checked.</p>
      <div class="filters" role="group" aria-label="Show">
        <button class="chip" aria-pressed="true" data-f="all">All</button>
        <button class="chip" aria-pressed="false" data-f="story">Stories</button>
        <button class="chip" aria-pressed="false" data-f="legend">Legends checked</button>
      </div>
    </header>
    <ol class="grid">
      {stories.map((s) => {
        const lead = leadOf(media.get(s.id) ?? []);
        return (
          <li data-k={s.data.kind}>
            <a href={`/stories/${s.id}/`} class="card">
              <div class:list={['pic', { doc: lead?.data.kind === 'document' }]}>
                {lead && <Picture src={mediaImage(lead.data.file)!} alt="" widths={[400, 700, 1000]} sizes="(max-width: 700px) 100vw, 420px" formats={['avif', 'webp']} loading="lazy" />}
                {s.data.kind === 'legend' && <span class="stamp land">Legend<small>checked</small></span>}
              </div>
              <div class="txt">
                <span class="meta">{fmtDate(s.data.date, s.data.precision, true)} · {s.data.programs.map((p) => PROGRAM_LABEL[p]).join(', ')}</span>
                <h2>{s.data.title}</h2>
                <p>{s.data.dek}</p>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .grid { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 14px; }
  .grid li[hidden] { display: none; }
  .card { display: grid; grid-template-rows: auto 1fr; height: 100%; text-decoration: none; color: var(--ink); background: var(--hull); border: 1px solid var(--seam); transition: border-color 0.2s, background 0.2s; }
  .card:hover { border-color: var(--seam-2); background: var(--hull-2); }
  .pic { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--void); }
  .pic :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85); transition: transform 0.6s cubic-bezier(.2, .7, .2, 1); }
  .card:hover .pic :global(img) { transform: scale(1.04); }
  /* a document page on its paper, the top of the page showing */
  .pic.doc { background: #e8e5dc; padding: 10px 10px 0; }
  .pic.doc :global(img) { object-fit: cover; object-position: top; filter: none; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08); }
  .pic .stamp { position: absolute; right: 12px; top: 12px; font-size: 0.78rem; background: rgba(5, 7, 10, 0.55); }
  .txt { padding: 14px 16px 18px; display: grid; gap: 8px; align-content: start; }
  .meta { font: 400 max(0.62rem, var(--floor))/1.4 var(--f-data); letter-spacing: 0.14em; text-transform: uppercase; color: var(--marking); }
  .txt h2 { margin: 0; font: 800 1.2rem/1.15 var(--f-display); font-stretch: 112%; text-transform: uppercase; color: var(--stencil); text-wrap: balance; }
  .txt p { margin: 0; font-size: 0.94rem; line-height: 1.5; color: var(--ink-2); }
  @media (prefers-reduced-motion: reduce) { .pic :global(img) { transition: none; } }
</style>

<script>
  const filters = document.querySelector('.filters');
  filters?.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest('button'); if (!b) return;
    filters.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLLIElement>('.grid li').forEach((li) => { li.hidden = !(b.dataset.f === 'all' || li.dataset.k === b.dataset.f); });
  });
</script>
